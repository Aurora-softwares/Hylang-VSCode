{
  "namespace": {
    "prefix": "namespace",
    "body": [
      "namespace ${1:MyApp} {",
      "    $0",
      "}"
    ],
    "description": "Create a Hydrogen namespace block"
  },
  "class": {
    "prefix": "class",
    "body": [
      "public class ${1:Program} {",
      "    $0",
      "}"
    ],
    "description": "Create a public class"
  },
  "main": {
    "prefix": "main",
    "body": [
      "public static void Main(string[] args) {",
      "    $0",
      "}"
    ],
    "description": "Create a Main entry point"
  },
  "writeline": {
    "prefix": "cw",
    "body": "System.Console.WriteLine(${1:\"Hello, Hydrogen!\"});",
    "description": "Write a line to the console"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Create an if block"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:count}; ${1:i} = ${1:i} + 1) {",
      "    $0",
      "}"
    ],
    "description": "Create a for loop"
  }
}
